<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="root" style="-fx-background-color: transparent; -fx-padding: 44;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sassyscreation.sassyscreationgui.controllers.ChangePasswordController">
   <stylesheets><URL value="@styles.css" /><URL value="@text-large.css" /></stylesheets>
   <children>
      <VBox maxWidth="420.0" prefWidth="420.0" spacing="2.0"
            styleClass="dialog-card"
            style="-fx-background-color: white; -fx-background-radius: 24; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(194, 42, 98, 0.22), 22, 0.1, 0, 6);">
         <children>
            <HBox alignment="CENTER" style="-fx-padding: 0 0 8 0;">
               <children>
                  <StackPane styleClass="icon-badge"><children><Region styleClass="ico, ico-key" /></children></StackPane>
               </children>
            </HBox>
            <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="dialog-title-dark" text="Change password" textAlignment="CENTER" />
            <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="page-sub" text="Enter your current password, then choose a new one." textAlignment="CENTER" wrapText="true" />
            <Label styleClass="form-label" text="Current password" style="-fx-padding: 8 0 4 0;" />
            <PasswordField fx:id="pfCurrentPassword" prefHeight="40.0" promptText="Enter current password" />
            <Label styleClass="form-label" text="New password" style="-fx-padding: 8 0 4 0;" />
            <PasswordField fx:id="pfChangeNew" prefHeight="40.0" promptText="Enter new password" />
            <Label styleClass="hint-label" text="At least 8 characters, including a number." style="-fx-padding: 6 0 0 0;" />
            <Label styleClass="form-label" text="Confirm new password" style="-fx-padding: 8 0 4 0;" />
            <PasswordField fx:id="pfChangeConfirm" prefHeight="40.0" promptText="Re-enter new password" />
            <Label fx:id="lblChangeError" styleClass="error-label" text="" wrapText="true" />
            <HBox spacing="14.0" styleClass="dialog-buttons">
               <children>
                  <Button fx:id="btnCancelPassword" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" mnemonicParsing="false" onAction="#handleCancelPassword" styleClass="btn-ghost" text="Cancel" />
                  <Button fx:id="btnSavePassword" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" mnemonicParsing="false" onAction="#handleSavePassword" styleClass="btn-primary" text="Save password" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</StackPane>
