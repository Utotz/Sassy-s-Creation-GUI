                                 </children>
                              </HBox>
                              <VBox alignment="CENTER_LEFT" spacing="18.0" styleClass="reminder-panel" VBox.vgrow="ALWAYS">
                                 <children>
                                    <Label fx:id="lblReminderTitle" styleClass="reminder-big" text="4 orders awaiting pickup" wrapText="true" />
                                    <Label styleClass="reminder-note" text="Don't forget to confirm pickup or meetup times with your customers." wrapText="true" />
                                 </children>
                              </VBox>
                           </children>
                        </VBox>
                     </children>
                                       <rowConstraints><RowConstraints minHeight="360.0" prefHeight="360.0" vgrow="NEVER" /></rowConstraints>
                  </GridPane>

                  <!-- row 2: low stock + orders by status + quick actions -->
                  <GridPane hgap="14.0">
                     <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" percentWidth="38.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" percentWidth="32.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="0.0" percentWidth="30.0" />
                     </columnConstraints>
                     <children>
                        <VBox minWidth="0.0" spacing="10.0" styleClass="card" GridPane.columnIndex="0">
                           <children>
                              <HBox alignment="CENTER_LEFT">
                                 <children>
                                    <Label minWidth="-Infinity" styleClass="card-title" text="Low stock warnings" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Hyperlink fx:id="linkLowStockAll" focusTraversable="false" mnemonicParsing="false" onAction="#handleOpenLowStock" styleClass="view-all-pill" text="View all" />
                                 </children>
                              </HBox>
                              <VBox styleClass="low-table-wrap" VBox.vgrow="ALWAYS">
                                 <children>
                                    <TableView fx:id="tvLowStock" fixedCellSize="44.0" focusTraversable="false" minHeight="176.0" prefHeight="176.0" styleClass="low-table" VBox.vgrow="ALWAYS">
                                       <placeholder><Label text="No low stock items" /></placeholder>
                                       <items><FXCollections fx:factory="observableArrayList">
<HashMap Category="Keychain" Name="Customized Keychain"><stock><Label styleClass="badge-low" text="0 · Out of stock" /></stock></HashMap>
<HashMap Category="Crochet" Name="Swimwear - Customize"><stock><Label styleClass="badge-low" text="0 · Out of stock" /></stock></HashMap>
<HashMap Category="Crochet" Name="Hat - Customize"><stock><Label styleClass="badge-low" text="0 · Out of stock" /></stock></HashMap>
                                       </FXCollections></items>
                                       <columns>
                                          <TableColumn fx:id="colLowName" prefWidth="170.0" text="Product"><cellValueFactory><MapValueFactory key="Name" /></cellValueFactory></TableColumn>
                                          <TableColumn fx:id="colLowCat" prefWidth="90.0" text="Category"><cellValueFactory><MapValueFactory key="Category" /></cellValueFactory></TableColumn>
                                          <TableColumn fx:id="colLowStock" prefWidth="120.0" text="Stock"><cellValueFactory><MapValueFactory key="stock" /></cellValueFactory></TableColumn>
                                       </columns>
                                       <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                    </TableView>
                                    <!-- design-time preview leftovers, kept hidden so existing controller references still resolve -->
                                    <VBox fx:id="lowStockSample" managed="false" visible="false" />
                                 </children>
                              </VBox>
                           </children>
                        </VBox>

                        <VBox minWidth="0.0" spacing="6.0" styleClass="card" GridPane.columnIndex="1">
                           <children>
                              <Label styleClass="card-title" text="Orders by Status" />
                              <Label fx:id="lblOrdersYear" managed="false" maxWidth="1.7976931348623157E308" styleClass="stat-note" text="Year 2026" visible="false" />
                              <StackPane VBox.vgrow="ALWAYS">
                                 <children>
                                    <!-- design-time preview only (gauge): hidden at run time so it never covers the real chart -->
                                    <HBox fx:id="pieSample" alignment="CENTER" mouseTransparent="true">
                                       <children>
                                          <VBox alignment="CENTER" spacing="14.0">
                                             <children>
                                                <StackPane maxHeight="124.0" maxWidth="230.0" minHeight="124.0" minWidth="230.0" prefHeight="124.0" prefWidth="230.0">
                                                   <children>
                                                      <Pane maxHeight="124.0" maxWidth="230.0" minHeight="124.0" minWidth="230.0" prefHeight="124.0" prefWidth="230.0">
                                                         <children>
                                                            <Arc centerX="115.0" centerY="115.0" fill="TRANSPARENT" length="120.0" radiusX="95.0" radiusY="95.0" startAngle="60.0" stroke="#C22A62" strokeLineCap="BUTT" strokeWidth="36.0" type="OPEN" />
                                                            <Arc centerX="115.0" centerY="115.0" fill="TRANSPARENT" length="30.0" radiusX="95.0" radiusY="95.0" startAngle="30.0" stroke="#E8A0BC" strokeLineCap="BUTT" strokeWidth="36.0" type="OPEN" />
                                                            <Arc centerX="115.0" centerY="115.0" fill="TRANSPARENT" length="30.0" radiusX="95.0" radiusY="95.0" startAngle="0.0" stroke="#DDD0D6" strokeLineCap="BUTT" strokeWidth="36.0" type="OPEN" />
                                                         </children>
                                                      </Pane>
                                                      <VBox alignment="BOTTOM_CENTER" maxHeight="70.0" StackPane.alignment="BOTTOM_CENTER">
                                                         <children>
                                                            <Label styleClass="gauge-pct" text="67%" />
                                                            <Label styleClass="stat-note" text="Pending" />
                                                         </children>
                                                      </VBox>
                                                   </children>
                                                </StackPane>
                                                <HBox alignment="CENTER" spacing="14.0">
                                                   <children>
                                                      <Label text="Pending  4" textFill="#5B5159"><graphic><Circle fill="#C22A62" radius="5.0" /></graphic></Label>
                                                      <Label text="Done  1" textFill="#5B5159"><graphic><Circle fill="#E8A0BC" radius="5.0" /></graphic></Label>
                                                      <Label text="Cancelled  1" textFill="#5B5159"><graphic><Circle fill="#DDD0D6" radius="5.0" /></graphic></Label>
                                                   </children>
                                                </HBox>
                                             </children>
                                          </VBox>
                                       </children>
                                    </HBox>
                                    <PieChart fx:id="statusChart" labelsVisible="false" legendSide="BOTTOM" styleClass="status-chart" />
                                 </children>
                              </StackPane>
                           </children>
                        </VBox>

                        <VBox minWidth="0.0" spacing="4.0" styleClass="card, quick-card" GridPane.columnIndex="2">
                           <children>
                              <Label styleClass="quick-title" text="Quick actions" />
                              <Label styleClass="quick-sub" text="Jump straight to a task" />
                              <Region VBox.vgrow="ALWAYS" />
                              <VBox spacing="10.0">
                                 <children>
                                    <Button fx:id="btnQuickOrder" focusTraversable="false" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#goOrders" styleClass="quick-btn, quick-btn-primary" text="New order"><graphic><Region styleClass="ico, ico-add" /></graphic></Button>
                                    <Button fx:id="btnQuickSale" focusTraversable="false" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#goStandSale" styleClass="quick-btn" text="Record stand sale"><graphic><Region styleClass="ico, ico-add" /></graphic></Button>
                                    <Button fx:id="btnQuickProduct" focusTraversable="false" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#goInventory" styleClass="quick-btn" text="Add product"><graphic><Region styleClass="ico, ico-add" /></graphic></Button>
                                 </children>
                              </VBox>
                           </children>
                        </VBox>
                     </children>
                                       <rowConstraints><RowConstraints minHeight="320.0" prefHeight="320.0" vgrow="NEVER" /></rowConstraints>
                  </GridPane>
                           </children>
                        </VBox>
                     </content>
                  </ScrollPane>
               </children>
            </VBox>
         </children>
      </VBox>
         </children>
      </StackPane>
   </children>
</HBox>
