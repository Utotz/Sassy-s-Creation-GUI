<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="root" style="-fx-background-color: transparent; -fx-padding: 44;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sassyscreation.sassyscreationgui.controllers.ErrorDialogController">
    <stylesheets><URL value="@styles.css" /><URL value="@text-large.css" /></stylesheets>
    <children>
        <VBox alignment="CENTER" maxWidth="420.0" prefWidth="420.0" spacing="8.0" styleClass="dialog-card">
            <children>
                <StackPane styleClass="icon-badge-sm"><children><Region styleClass="ico, ico-close" /></children></StackPane>
                <Label fx:id="lblErrorTitle" alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="dialog-title-dark" text="Please check your input" />
                <Label fx:id="lblErrorMessage" alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="dialog-text" text="Please fill in all required fields." textAlignment="CENTER" wrapText="true" />
                <!-- reuse for: empty fields, invalid price or quantity, not enough stock, wrong username or password, product already exists -->
                <VBox alignment="CENTER" spacing="8.0" styleClass="dialog-buttons">
                    <children>
                        <Button fx:id="btnOk" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleOk" styleClass="btn-danger" text="OK" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>
