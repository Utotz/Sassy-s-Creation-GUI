<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Ellipse?>
<?import javafx.scene.shape.Rectangle?>

<StackPane prefHeight="290" prefWidth="340" styleClass="dialog-root, page-v3" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <stylesheets><URL value="@styles.css" /><URL value="@text-large.css" /></stylesheets>
   <children>
      <VBox alignment="CENTER">
   <children>
      <VBox alignment="CENTER" maxWidth="300.0" spacing="4.0" styleClass="dialog-card">
         <children>
            <!-- falling + bouncing flowers (animated GIF, plays automatically) -->
            <ImageView fitHeight="150.0" fitWidth="240.0" pickOnBounds="true" preserveRatio="true">
               <image><Image url="@../../../drawables/loading_flowers.gif" /></image>
            </ImageView>
            <!-- kept hidden so existing controller references to piLoading still work -->
            <ProgressBar fx:id="piLoading" managed="false" prefWidth="1.0" progress="0.0" visible="false" />
            <Label fx:id="lblLoading" alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="dialog-title-dark" text="Please wait..." />
            <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="page-sub" text="A flower blooms again and again" textAlignment="CENTER" wrapText="true" />
         </children>
      </VBox>
   </children>
</VBox>
   </children>
</StackPane>
