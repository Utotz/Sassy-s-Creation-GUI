<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="root" style="-fx-background-color: transparent; -fx-padding: 44;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sassyscreation.sassyscreationgui.controllers.LoadingController">
    <stylesheets><URL value="@styles.css" /><URL value="@text-large.css" /></stylesheets>
    <children>
        <VBox alignment="CENTER" maxWidth="300.0" prefWidth="300.0" spacing="4.0" styleClass="dialog-card">
            <children>
                <!-- falling + bouncing flowers (animated GIF, plays automatically) -->
                <ImageView fitHeight="150.0" fitWidth="240.0" pickOnBounds="true" preserveRatio="true">
                    <image><Image url="@../../../drawables/loading_flowers.gif" /></image>
                </ImageView>
                <!-- kept hidden so the controller's piLoading reference still works -->
                <ProgressBar fx:id="piLoading" managed="false" prefWidth="1.0" progress="0.0" visible="false" />
                <Label fx:id="lblLoading" alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="dialog-title-dark" text="Please wait..." />
                <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="page-sub" text="A flower blooms again and again" textAlignment="CENTER" wrapText="true" />
            </children>
        </VBox>
    </children>
</StackPane>
