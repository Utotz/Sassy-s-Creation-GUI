<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="root" style="-fx-background-color: transparent; -fx-padding: 44;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sassyscreation.sassyscreationgui.controllers.LogoutController">
    <stylesheets><URL value="@styles.css" /><URL value="@text-large.css" /></stylesheets>
    <children>
        <VBox alignment="CENTER" maxWidth="420.0" prefWidth="420.0" spacing="6.0" styleClass="dialog-card, dialog-card-pink">
            <children>
                <StackPane styleClass="icon-badge-sm"><children><Region styleClass="ico, ico-logout" /></children></StackPane>
                <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="dialog-title-dark" text="Log out?" />
                <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="dialog-text" text="You will need to sign in again to open Sassy’s Creation." textAlignment="CENTER" wrapText="true" />
                <Region prefHeight="6.0" />
                <VBox alignment="CENTER" spacing="8.0" styleClass="dialog-buttons">
                    <children>
                        <Button fx:id="btnConfirmLogout" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleConfirmLogout" styleClass="btn-primary" text="Yes, log out" />
                        <Button fx:id="btnCancelLogout" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleCancelLogout" styleClass="btn-ghost" text="Stay logged in" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>
