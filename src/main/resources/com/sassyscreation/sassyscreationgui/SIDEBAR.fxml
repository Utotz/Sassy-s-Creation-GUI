<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  Shared left navigation panel. Used by every screen with:
      <fx:include fx:id="sidebar" source="SIDEBAR.fxml" styleClass="page-inventory" />
  styleClass = page-dashboard | page-orders | page-standsale | page-inventory  (highlights that menu item)
-->
<VBox fx:id="sidebarRoot" fx:controller="com.sassyscreation.sassyscreationgui.controllers.SidebarController" minWidth="228.0" prefWidth="228.0" styleClass="sidebar" viewOrder="-1.0" style="-fx-background-color: #F8D3E2; -fx-background-insets: 0; -fx-background-radius: 0 28 28 0; -fx-border-color: transparent; -fx-border-width: 0; -fx-effect: dropshadow(gaussian, rgba(150, 40, 90, 0.20), 30, 0.10, 8, 0);" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <stylesheets><URL value="@styles.css" /><URL value="@text-large.css" /></stylesheets>
   <padding><Insets bottom="4.0" left="4.0" right="4.0" top="4.0" /></padding>
   <children>
      <VBox prefHeight="731.0" prefWidth="220.0" styleClass="side-panel" style="-fx-background-radius: 24;" VBox.vgrow="ALWAYS">
         <children>
            <!-- BRAND LOGO -->
            <HBox alignment="CENTER" styleClass="brand-box">
               <padding><Insets bottom="10.0" left="8.0" right="8.0" top="10.0" /></padding>
               <children>
                  <ImageView fitHeight="110.0" fitWidth="190.0" pickOnBounds="true" preserveRatio="true" smooth="true">
                     <image><Image url="@../../../drawables/sassys-logo.png" /></image>
                  </ImageView>
               </children>
            </HBox>
            <Label styleClass="side-section" text="MENU" />
            <VBox spacing="4.0">
               <padding><Insets bottom="14.0" top="2.0" /></padding>
               <children>
                  <Button fx:id="navDashboard" focusTraversable="false" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#goDashboard" styleClass="nav-btn" text="Dashboard"><graphic><Region styleClass="ico, ico-dashboard" /></graphic></Button>
                  <StackPane>
                     <children>
                        <Button fx:id="navOrders" focusTraversable="false" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#goOrders" styleClass="nav-btn" text="Orders"><graphic><Region styleClass="ico, ico-cart" /></graphic></Button>
                        <Label fx:id="lblNavOrdersBadge" mouseTransparent="true" styleClass="nav-badge" text="4" StackPane.alignment="CENTER_RIGHT">
                           <StackPane.margin><Insets right="14.0" /></StackPane.margin>
                        </Label>
                     </children>
                  </StackPane>
                  <Button fx:id="navStandSale" focusTraversable="false" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#goStandSale" styleClass="nav-btn" text="Stand Sale"><graphic><Region styleClass="ico, ico-store" /></graphic></Button>
                  <Button fx:id="navInventory" focusTraversable="false" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#goInventory" styleClass="nav-btn" text="Inventory"><graphic><Region styleClass="ico, ico-box" /></graphic></Button>
               </children>
            </VBox>
            <Region VBox.vgrow="ALWAYS" />
            <Button fx:id="btnLogout" focusTraversable="false" managed="false" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleLogout" styleClass="nav-logout" text="Log out" visible="false"><graphic><Region styleClass="ico, ico-logout" /></graphic>
               <VBox.margin><Insets bottom="8.0" /></VBox.margin>
            </Button>
            <!-- Admin Officer card -->
            <MenuButton fx:id="mbAccount" contentDisplay="GRAPHIC_ONLY" maxWidth="1.7976931348623157E308" mnemonicParsing="false" popupSide="TOP" styleClass="side-user">
               <graphic>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label styleClass="side-user-avatar" text="A" />
                        <VBox alignment="CENTER_LEFT" spacing="1.0">
                           <children>
                              <Label styleClass="side-user-name" text="Admin Officer" />
                              <Label styleClass="side-user-role" text="Sassy’s Creation" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </graphic>
               <items>
                  <MenuItem fx:id="miChangePassword" mnemonicParsing="false" onAction="#handleOpenChangePassword" styleClass="account-item" text="Change password"><graphic><Region styleClass="ico, ico-key" /></graphic></MenuItem>
                  <MenuItem fx:id="miAbout" mnemonicParsing="false" onAction="#handleOpenAbout" styleClass="account-item" text="About"><graphic><Region styleClass="ico, ico-info" /></graphic></MenuItem>
                  <SeparatorMenuItem />
                  <MenuItem fx:id="miLogout" mnemonicParsing="false" onAction="#handleLogout" styleClass="account-item" text="Log out"><graphic><Region styleClass="ico, ico-logout" /></graphic></MenuItem>
               </items>
            </MenuButton>
         </children>
      </VBox>
   </children>
</VBox>
