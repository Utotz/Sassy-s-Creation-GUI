<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="root" style="-fx-background-color: transparent; -fx-padding: 44;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sassyscreation.sassyscreationgui.controllers.UnsavedChangesController">
    <stylesheets><URL value="@styles.css" /><URL value="@text-large.css" /></stylesheets>
    <children>
        <VBox alignment="CENTER" maxWidth="420.0" prefWidth="420.0" spacing="6.0" styleClass="dialog-card">
            <children>
                <StackPane styleClass="icon-badge-sm"><children><Region styleClass="ico, ico-warning" /></children></StackPane>
                <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="dialog-title-dark" text="Discard changes?" />
                <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="dialog-text" text="You have unsaved changes. If you leave now, they will be lost." textAlignment="CENTER" wrapText="true" />
                <Region prefHeight="6.0" />
                <VBox alignment="CENTER" spacing="8.0" styleClass="dialog-buttons">
                    <children>
                        <Button fx:id="btnDiscard" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleDiscard" styleClass="btn-warn" text="Yes, discard" />
                        <Button fx:id="btnKeepEditing" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleKeepEditing" styleClass="btn-ghost" text="Keep editing" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>
