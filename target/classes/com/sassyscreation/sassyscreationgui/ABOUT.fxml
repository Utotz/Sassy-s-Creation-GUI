<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<StackPane fx:id="root" style="-fx-background-color: transparent; -fx-padding: 44;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sassyscreation.sassyscreationgui.controllers.AboutController">
    <stylesheets><URL value="@styles.css" /></stylesheets>
    <children>
        <VBox alignment="CENTER" maxWidth="480.0" prefWidth="480.0" spacing="12.0"
              styleClass="dialog-card"
              style="-fx-background-color: white; -fx-background-radius: 24; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(194, 42, 98, 0.22), 22, 0.1, 0, 6);">
            <children>
                <Pane maxHeight="72" maxWidth="72" minHeight="72" minWidth="72" prefHeight="72" prefWidth="72">
                    <children>
                        <Ellipse centerX="52.9" centerY="36.0" fill="#C22A62" radiusX="15.8" radiusY="10.7" rotate="0.0" />
                        <Ellipse centerX="44.4" centerY="50.6" fill="#C22A62" radiusX="15.8" radiusY="10.7" rotate="60.0" />
                        <Ellipse centerX="27.6" centerY="50.6" fill="#C22A62" radiusX="15.8" radiusY="10.7" rotate="120.0" />
                        <Ellipse centerX="19.1" centerY="36.0" fill="#C22A62" radiusX="15.8" radiusY="10.7" rotate="180.0" />
                        <Ellipse centerX="27.6" centerY="21.4" fill="#C22A62" radiusX="15.8" radiusY="10.7" rotate="240.0" />
                        <Ellipse centerX="44.4" centerY="21.4" fill="#C22A62" radiusX="15.8" radiusY="10.7" rotate="300.0" />
                        <Circle centerX="36.0" centerY="36.0" fill="#FFE08A" radius="7.9" />
                    </children>
                </Pane>
                <Label style="-fx-padding: 8 0 0 0;" styleClass="dialog-title-primary" text="Sassy’s Creation" />
                <Label styleClass="dialog-text" text="Sales and Order Management System" textAlignment="CENTER" wrapText="true" />
                <Label styleClass="dialog-text" text="Handmade Crochet and Bouquets" />
                <Label fx:id="lblVersion" style="-fx-padding: 6 0 10 0;" styleClass="stat-note" text="Version 1.0.0" />
                <HBox alignment="CENTER" styleClass="dialog-buttons">
                    <children>
                        <Button fx:id="btnCloseAbout" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleCloseAbout" styleClass="btn-primary" text="Close" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>