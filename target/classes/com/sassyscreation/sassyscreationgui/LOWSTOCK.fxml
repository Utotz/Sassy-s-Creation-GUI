<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import java.net.URL?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:controller="com.sassyscreation.sassyscreationgui.controllers.LowStockController"
           style="-fx-background-color: transparent; -fx-padding: 44;"
           xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <stylesheets><URL value="@styles.css" /></stylesheets>
   <children>
      <VBox alignment="CENTER_LEFT" maxWidth="480.0" prefWidth="480.0" spacing="12.0"
            style="-fx-padding: 24;" styleClass="dialog-card">
         <children>
            <Label alignment="CENTER" contentDisplay="LEFT" graphicTextGap="8.0" maxWidth="1.7976931348623157E308" styleClass="dialog-title" text="Low stock items" textAlignment="CENTER">
               <graphic><Region styleClass="ico, ico-warning" /></graphic>
            </Label>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label styleClass="dialog-text" text="Category" />
                  <ComboBox fx:id="cbLowCategory" prefWidth="100.0" promptText="All" value="All">
                     <items>
                        <FXCollections fx:factory="observableArrayList">
                           <String fx:value="All" />
                           <String fx:value="Bouquet" />
                           <String fx:value="Crochet" />
                           <String fx:value="Keychain" />
                        </FXCollections>
                     </items>
                  </ComboBox>
                  <Label styleClass="dialog-text" text="Stock at or below" />
                  <Spinner fx:id="spThreshold" editable="true" initialValue="5" max="999" maxWidth="1.7976931348623157E308" min="0" prefWidth="110.0" styleClass="split-arrows-horizontal" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            <TableView fx:id="tvLowStock" fixedCellSize="44.0" prefHeight="290.0">
               <placeholder><Label text="No low stock items" /></placeholder>
               <columns>
                  <TableColumn fx:id="colLowName" prefWidth="230.0" text="Name"><cellValueFactory><MapValueFactory key="Name" /></cellValueFactory></TableColumn>
                  <TableColumn fx:id="colLowCat" prefWidth="110.0" text="Category"><cellValueFactory><MapValueFactory key="Category" /></cellValueFactory></TableColumn>
                  <TableColumn fx:id="colLowStock" prefWidth="80.0" text="Stock"><cellValueFactory><MapValueFactory key="stock" /></cellValueFactory></TableColumn>
               </columns>
               <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
            </TableView>
            <Label fx:id="lblLowStockCount" styleClass="stat-note" text="0 out of stock · 0 low" />
            <HBox alignment="CENTER" spacing="14.0" styleClass="dialog-buttons">
               <children>
                  <Button fx:id="btnCloseLowStock" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleCloseLowStock" styleClass="btn-ghost" text="Close" HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnGoInventory" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleGoToInventory" styleClass="btn-primary" text="Go to Inventory" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</StackPane>